{
  "name": "@fenix/server",
  "private": true,
  "version": "0.1.0",
  "description": "Servidor autoritativo del juego",
  "type": "module",
  "exports": {
    "./embedded": "./src/embedded.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outfile=dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fenix/content": "0.1.0",
    "@fenix/shared": "0.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
