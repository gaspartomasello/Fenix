# Copiar como .env en el servidor y completar. Guía: docs/SERVIDOR.md

# La dirección del juego. Sin dominio propio: la IP pública con guiones + .sslip.io
# (por ejemplo, para la IP 152.67.10.20: 152-67-10-20.sslip.io).
DOMINIO=

# Administradores del juego (nombres de personaje, separados por coma).
ADMINS=

# Personajes de prueba (todo al máximo). En el servidor de verdad, dejarlo vacío.
TEST_CHARACTERS=

# Semilla del mapa: con la misma semilla, el mundo es siempre el mismo.
MAP_SEED=1997

# Copias afuera del servidor (opcional; ver la guía). Cloudflare R2:
#   COPIAS_REMOTO=remoto:nombre-del-balde
#   COPIAS_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
COPIAS_REMOTO=
COPIAS_PROVEEDOR=Cloudflare
COPIAS_ENDPOINT=
COPIAS_CLAVE_ID=
COPIAS_CLAVE_SECRETA=
